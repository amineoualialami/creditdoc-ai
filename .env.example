# ============================================
# CreditDoc AI — Configuration
# ============================================
# Completer les valeurs manquantes.
# Ne JAMAIS committer le .env (il contient des secrets).

# --- Mode d'execution ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Modeles LLM via LiteLLM ---
# En mode local, format : ollama/<nom_du_modele>
LITELLM_MODEL=ollama/llama3.3:8b
LITELLM_EMBEDDING_MODEL=ollama/nomic-embed-text
OLLAMA_API_BASE=http://localhost:11434

# En mode cloud (semaine 12), decommenter et renseigner :
# LITELLM_MODEL=bedrock/anthropic.claude-sonnet-4-5
# LITELLM_EMBEDDING_MODEL=bedrock/amazon.titan-embed-text-v2:0
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Qdrant (vector store) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=creditdoc

# --- Langfuse (observabilite) ---
# Cles creees a l'etape 6 (dashboard Langfuse) ou pre-generees via docker-compose
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_SDK_MODE=legacy